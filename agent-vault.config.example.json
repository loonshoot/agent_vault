{
  "vaults": {
    "dev": {
      "type": "1password",
      "serviceAccountToken": "env:OP_DEV_TOKEN",
      "vaultIds": ["your-dev-vault-id"],
      "ttl": 30,
      "ttlScope": "vault"
    },
    "prod": {
      "type": "1password",
      "serviceAccountToken": "env:OP_PROD_TOKEN",
      "vaultIds": ["your-prod-vault-id"],
      "ttl": 0,
      "ttlScope": "secret"
    },
    "local": {
      "type": "env",
      "file": ".env.secrets",
      "ttl": 15,
      "ttlScope": "secret"
    }
  },
  "ngrokAuthToken": "env:NGROK_AUTHTOKEN",
  "port": 9999,

  "_comment_transport": "Uncomment to run as one shared HTTP process for multiple workers instead of stdio. Also settable via --http/--port/--host or AGENT_VAULT_TRANSPORT/AGENT_VAULT_HTTP_PORT/AGENT_VAULT_HTTP_HOST.",
  "transport": "stdio",
  "httpPort": 8080,
  "httpHost": "127.0.0.1",

  "webhooks": [
    {
      "_comment": "Free, zero-signup push notifications the instant any worker blocks on a secret. Pick a long random topic name.",
      "url": "https://ntfy.sh/agent-vault-<pick-something-random-and-unguessable>",
      "format": "ntfy",
      "events": ["pending"]
    }
  ]
}
